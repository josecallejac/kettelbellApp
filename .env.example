# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIA-ESTO-por-una-clave-generada
DJANGO_DEBUG=False
DJANGO_ALLOW_REGISTRATION=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Origenes confiables para CSRF cuando se sirve con dominio propio (ej: https://miapp.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Activar solo si la app se sirve detras de HTTPS
DJANGO_ENABLE_HTTPS=False
KETTLEBELL_RELEASE_SHA=unknown
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=kettlebell
POSTGRES_USER=kettlebell
POSTGRES_PASSWORD=CAMBIA-ESTO-por-un-password-seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Desde tu PC, la BD queda disponible en localhost:5433.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@kettlebellpro.app
