DJANGO_SECRET_KEY=local-docker-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Origenes confiables para CSRF cuando se sirve con dominio propio (ej: https://miapp.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Activar solo si la app se sirve detras de HTTPS
DJANGO_ENABLE_HTTPS=False
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=kettlebell
POSTGRES_USER=kettlebell
POSTGRES_PASSWORD=kettlebell
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Desde tu PC, la BD queda disponible en localhost:5433.
